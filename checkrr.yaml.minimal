lang: "en-us"
checkrr:
  checkpath: 
    - "./test"
  database: ./checkrr.db
  debug: true
  # Empty disables automatic scans; run them from the web UI or API.
  cron: ""
  ignorehidden: true
  ignorepaths:
    - 'media/ignored'
  ignoreexts:
    - .txt
    - .nfo
    - .nzb
    - .url
logs:
  stdout:
    out: stdout
    formatter: default